# ── Project Sentinel — LLM provider config ─────────────────────────────
# Provider: DeepSeek V4 Flash 0731 qua OpenRouter (OpenAI-compatible).
# KHÔNG dùng OpenAI / Gemini / Anthropic.
# Copy file này thành `.env` rồi điền key thật. `.env` KHÔNG được commit (đã ignore).

# API key OpenRouter (tạo tại https://openrouter.ai/keys — dạng sk-or-v1-...)
OPENAI_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_KEY

# Endpoint OpenRouter (OpenAI-compatible)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model id trên OpenRouter
OPENAI_MODEL=deepseek/deepseek-v4-flash-0731

# (Tuỳ chọn) giá token để ước lượng FinOps — chỉnh theo bảng giá OpenRouter thực tế (USD / 1M tokens)
# SENTINEL_COST_IN_PER_1M=0.15
# SENTINEL_COST_OUT_PER_1M=0.60

# Ghi chú: nếu OPENAI_API_KEY để trống → agents chạy MOCK offline (JSON deterministic), không gọi mạng.
